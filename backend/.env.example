MONGODB_URI=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional alternative to the three FIREBASE_* credential variables above.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional INCI Decoder lookup (website search; no official API).
INCI_DECODER_BASE_URL=https://incidecoder.com
INCI_DECODER_TIMEOUT_MS=15000

# Cloudinary product image uploads (backend only; never expose the secret).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
